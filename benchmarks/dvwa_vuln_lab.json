    "anchor_paths": "relative_to_source_root"
  },
  "scope": {
    "purpose": "Static source-to-sink regression baseline for vulnerability classes currently expressible by the AuditForge PHP taxonomy.",
    "included_taxonomies": [
      "command_injection",
      "sql_injection",
      "cross_site_scripting",
      "path_traversal",
      "server_side_request_forgery",
      "authentication_failure",
      "authorization_failure"
    ],
    "security_levels": ["low", "medium", "high", "impossible"],
    "counting_unit": "A truth item represents a distinct vulnerable or safe source-to-sink path. Multiple operating-system and database branches are intentionally separate paths.",
    "notes": [
      "The DOM XSS sink is shared by all security levels and changes behavior through the runtime $decodeURI value. It is represented once and must not be counted as four independent statically attributable findings.",
      "File Inclusion low and medium permit remote URL inclusion when PHP allow_url_include is enabled, so those paths are also SSRF truth items. High remains a path-traversal/file-inclusion case but is a safe negative for SSRF.",
      "Stored XSS paths terminate in the shared guestbook renderer. Medium and high encode message but leave name bypassable; impossible encodes both fields.",
      "CSP impossible is not used as a safe negative because the checkout also exposes the high-level same-origin JSONP callback endpoint, making an isolated CSP-only classification contestable.",
      "BAC high is a safe negative: executable code initializes its session identity from the current server-side user. The help text describing a client-controlled cookie is stale.",
      "Authentication bypass variants are excluded because their vulnerable and safe behavior is implemented in shared companion files and cannot be distinguished with source/sink anchors alone."
    ],
    "unsupported_modules": [
      "csrf",
      "unrestricted_file_upload",
      "weak_session_ids",
      "authentication_bypass",
      "open_redirect",
      "cryptographic_failures",
      "client_side_javascript_logic",
      "api_sensitive_data_exposure",
      "api_mass_assignment"
    ],
    "excluded_from_precision": "The corpus is not closed-world outside the listed truth paths. Unmatched findings in other DVWA modules require manual triage and must not automatically be treated as false positives."
  },
